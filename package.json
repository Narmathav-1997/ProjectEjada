{
  "name": "ejada-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright (JavaScript) UI + API test automation framework: Page Object Model, cross-browser, parallel, Allure + HTML reports",
  "scripts": {
    "install:browsers": "playwright install --with-deps chromium firefox",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chrome --project=ui-firefox",
    "test:api": "playwright test --project=api",
    "test:chrome": "playwright test --project=ui-chrome",
    "test:firefox": "playwright test --project=ui-firefox",
    "test:headed": "playwright test --project=ui-chrome --headed --workers=1",
    "test:debug": "playwright test --project=ui-chrome --debug",
    "report:html": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9"
  },
  "license": "MIT"
}
